# AegisFlow environment
#
# Every key is OPTIONAL. With none set, the full workflow runs end to end on
# honest local fallbacks and every screen stays usable — that is how it was built.
# Add a key and that path switches to LIVE on the next run. Check /integrations in
# the running app for what is actually live.

# ── Gemini ────────────────────────────────────────────────────────────────────
# Interpretation only: the analyst summary and the decision narrative, both
# Zod-validated. It never invents a fact or a score.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── SerpApi — "Best AI Use Case" ──────────────────────────────────────────────
# Live web intelligence. Free: 250 searches/mo, no card.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# ── Nutrient DWS — "Documents People Actually Trust" ──────────────────────────
# PDF field extraction on ingest, agreement watermark on output.
# https://dashboard.nutrient.io  (Processor API key)
# Free tier is 50 credits and each extraction costs ~3, so by default only the
# three conflict-bearing documents go through DWS. NUTRIENT_FULL=true routes all
# six (~18 credits per run). Out of credits? douglas@nutrient.io is the contact.
NUTRIENT_API_KEY=
NUTRIENT_FULL=false

# ── name.com Core API — "Domain API Challenge" ────────────────────────────────
# Supplier legitimacy from the domain system: a manufacturer claiming eight years
# of trading whose domain is still purchasable has no commercial footprint.
# HTTP Basic auth (username:token). Sandbox is api.dev.name.com with `-test`
# credentials. https://docs.name.com/guides/authentication
NAMECOM_API_BASE=https://api.name.com
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# ── Doctavian — "Generate It Right. Sign It Tight." ───────────────────────────
# BOTH are required before Doctavian goes live: the gateway enforces the API key
# AND an OAuth bearer.
#   DOCTAVIAN_API_KEY       subscription key, sent as X-Api-Key
#   DOCTAVIAN_ACCESS_TOKEN  Microsoft OAuth2 bearer. The flow is authorization_code
#                           + PKCE — i.e. interactive — so mint it once via
#                           "Get New Access Token" in Doctavian's Postman
#                           collection and paste it here. It expires; re-mint
#                           before a demo.
# No template URN: the demo environment consumes an uploaded template on first
# use, so the app builds and uploads one per generation.
# Verify with `node scripts/doctavian-setup.mjs --check`.
DOCTAVIAN_API_BASE=https://demo.api.doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_ACCESS_TOKEN=
# Strongly preferred: the login also issues a refresh token (the collection asks for
# `offline_access`). With this set the bearer renews itself instead of going stale
# mid-demo. In Postman: Authorization -> Advanced / the token detail panel -> copy
# "refresh_token" alongside the access token.
DOCTAVIAN_REFRESH_TOKEN=

# ── Foxit eSign — "Your Agent Shouldn't Sign That" ────────────────────────────
# On the unified Foxit Document APIs platform, the SAME client_id / client_secret
# that authenticate PDF Services also authenticate eSign — sent directly as
# headers against na1.fusion.foxit.com. No token exchange, no second signup.
# Get them from https://app.developer-api.foxit.com (Dashboard → eSign API shows
# them pre-filled with a runnable starter request).
# Note: Foxit's standalone eSign product (foxitesign.foxit.com) is a different
# thing with its own OAuth2 keys. This app targets the unified platform.
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_ESIGN_HOST=https://na1.fusion.foxit.com   # eu1 / au1 for other regions

# ── Xano — "Rebuild a SaaS Tool You Hate" ─────────────────────────────────────
# System of record: normalised incident/supplier/claim tables + an append-only
# audit stream. Free plan: https://www.xano.com/ — see docs/xano-setup.md for the
# four tables (auto-generated CRUD only, no custom endpoints).
XANO_API_BASE=
XANO_API_TOKEN=
# true seeds INC-1042 at runtime; prefer `node scripts/seed-xano.mjs` instead.
XANO_AUTO_SEED=false

# Optional tuning for the free tier's 10 req/20s limit. Defaults are fine.
# XANO_SEED_DELAY_MS=2100    # pacing between the paced supplier/claim writes
# XANO_RETRY_DELAY_MS=20000  # wait before retrying the one critical write on 429

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
