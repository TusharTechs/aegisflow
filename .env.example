# AegisFlow — all keys are OPTIONAL.
# With none set, the full workflow runs end-to-end on honest local fallbacks and
# every screen stays usable. Add a key and that path switches to LIVE on the next run.
# See /integrations in the running app for live status.

# --- Gemini (interpretation only: analyst summary + decision narrative, Zod-validated) ---
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- SerpApi (live web intelligence — "Best AI Use Case" challenge) ---
# Free: 250 searches/mo, no card. Key on dashboard: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Nutrient DWS (PDF extraction + agreement watermark — "Documents people trust" challenge) ---
# Free plan, no card: https://dashboard.nutrient.io  (Processor API key)
# Free tier = 50 credits total (~3 per extraction). By default only the
# conflict-bearing documents go through DWS; set NUTRIENT_FULL=true to route all six.
# Out of credits? Email douglas@nutrient.io (the challenge contact) for a top-up.
NUTRIENT_API_KEY=
NUTRIENT_FULL=false

# --- Doctavian (agreement generation — "Generate It Right. Sign It Tight." challenge) ---
# Request access: https://www.doctavian.com/  (hello@doctavian.com)
# Doctavian generates from an UPLOADED TEMPLATE and an UPLOADED DATA FILE, both
# referenced by URN — not from a free-text template id with inline variables.
# Two credentials are required and BOTH are enforced: the subscription key
# (X-Api-Key) and a Microsoft OAuth2 bearer (authorization_code + PKCE). The OAuth
# flow is interactive, so mint the bearer once via "Get New Access Token" in the
# Doctavian Postman collection and paste it here.
DOCTAVIAN_API_BASE=https://demo.api.doctavian.com
DOCTAVIAN_API_KEY=
DOCTAVIAN_ACCESS_TOKEN=
# URN returned by POST /v1/documents/template/upload for the agreement template.
DOCTAVIAN_TEMPLATE_URN=
DOCTAVIAN_TEMPLATE_FORMAT=docx

# --- Foxit eSign (signing handoff — "Your Agent Shouldn't Sign That" challenge) ---
# IMPORTANT: eSign has its OWN credentials and its own host. The PDF Services
# client_id / client_secret from developer-api.foxit.com do NOT authenticate here —
# the token endpoint answers `invalid_client`. Sign up at https://account.foxit.com
# and take the API Key / API Secret from the eSign portal. Auth is OAuth2
# client_credentials against /api/oauth2/access_token, exchanged for a bearer token.
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=
FOXIT_ESIGN_HOST=https://na1.foxitesign.foxit.com   # eu1 / na2 / au1 for other regions

# --- name.com Core API (supplier domain footprint — "Domain API Challenge") ---
# HTTP Basic auth: username:token. Sandbox is api.dev.name.com with `-test`
# credentials; production is api.name.com. https://docs.name.com/guides/authentication
NAMECOM_API_BASE=https://api.name.com
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# --- Xano (system of record — "Rebuild a SaaS Tool You Hate" challenge) ---
# Free plan: https://www.xano.com/  — see docs/xano-setup.md for the 4 tables
XANO_API_BASE=
XANO_API_TOKEN=
XANO_AUTO_SEED=true
